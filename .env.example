# -----------------------------------------------------------------------------
# Nexolu Communications - configuracion de ejemplo
# Copiar a .env y completar. Nunca commitear el .env real.
# -----------------------------------------------------------------------------

# Persistencia. Por defecto SQLite (cero infraestructura para desarrollo local).
# En produccion usar MySQL: mysql+aiomysql://user:pass@host:3306/nexolu_comms
DATABASE_URL=sqlite+aiosqlite:///./nexolu_comms_api.db

# --- WhatsApp Cloud API (Meta) ---
# La version del Graph API es global (misma para todas las apps); las
# credenciales (phone_number_id/access_token) son por app - ver
# NEXOLU_APPS_JSON abajo.
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# Tarifa por categoria de plantilla, en micro-dolares (1_000_000 = US$1).
# Meta cobra distinto segun la categoria - ajustar si Meta cambia sus
# tarifas. `service` (respuestas dentro de la ventana de 24h) es gratis.
WHATSAPP_RATE_MARKETING_MICROS=25000
WHATSAPP_RATE_UTILITY_MICROS=8000
WHATSAPP_RATE_AUTHENTICATION_MICROS=10000
WHATSAPP_RATE_SERVICE_MICROS=0

# --- Email transaccional (Brevo) ---
# API key de PLATAFORMA, usada por cualquier app que no traiga la suya
# propia en NEXOLU_APPS_JSON (ver `email.brevo_api_key` abajo).
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3

HTTP_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# Registro de aplicaciones cliente (POS, Spa, EasyTickets, ...).
# JSON: {"app_id": {"api_key", "name"?, "whatsapp"?, "email"?}}
#
# Cada app llama a este servicio con `Authorization: Bearer <api_key>`.
#
# "whatsapp" (opcional): {"phone_number_id", "access_token", "waba_id"?,
#   "webhook_verify_token"?, "meta_app_secret"?, "callback_url"?,
#   "callback_secret"?} - cada app tiene su propio numero de WhatsApp
#   Business, no se comparte uno solo. Sin `phone_number_id`/`access_token`,
#   GET/POST que pidan el canal "whatsapp" para esa app devuelven
#   status="skipped" (no rompen la llamada completa). Los 4 campos de
#   webhook son para GET/POST /webhooks/whatsapp/{app_id} - ver
#   nexolu_comms_api/api/webhooks.py:
#     - webhook_verify_token: lo que Meta devuelve en el handshake GET al
#       configurar el webhook en su dashboard (lo elige quien lo configura).
#     - meta_app_secret: App Secret del dashboard de Meta (NO el access
#       token) - verifica que el POST entrante de verdad vino de Meta.
#       Opcional: sin el, se salta esa verificacion (con warning en el log).
#     - callback_url: a donde esta app quiere que se le reenvie (firmado)
#       cada evento entrante. Sin `callback_url`+`callback_secret`, los
#       eventos entrantes se reciben pero no se reenvian a ningun lado.
#     - callback_secret: propio de esta app (nunca lo ve Meta) - firma el
#       reenvio, mismo esquema HMAC que ya usa Nexolu Payments Core
#       (X-Nexolu-Timestamp/X-Nexolu-Signature).
#
# "email" (opcional): {"from_email", "from_name"?, "brevo_api_key"?} - la
#   identidad de remitente de la app. `brevo_api_key` es opcional: sin ella,
#   el envio usa BREVO_API_KEY de arriba (la cuenta de Brevo compartida).
# -----------------------------------------------------------------------------
NEXOLU_APPS_JSON={"pos": {"api_key": "dev-pos-key", "name": "Nexolu POS", "whatsapp": {"phone_number_id": "000000000000000", "access_token": "EAAxxxxx", "webhook_verify_token": "un-token-cualquiera", "meta_app_secret": "", "callback_url": "https://pos-backend.nexolu.co/api/webhooks/nexolu-comms/whatsapp", "callback_secret": "un-secreto-compartido-con-el-pos"}, "email": {"from_email": "no-reply@nexolu.co", "from_name": "Nexolu POS"}}}

# API key de PLATAFORMA (Nexolu, no una app individual): da acceso a
# GET /v1/platform/usage, GET /v1/platform/notifications y a TODO
# /v1/admin/apps/* (gestion de apps/credenciales de proveedor). Vacia = esos
# endpoints responden 503. Nunca se le entrega a una app integradora - cada
# una ve solo su propio gasto con su propia api_key en GET /v1/usage/*.
NEXOLU_PLATFORM_API_KEY=

# Cifra en reposo las credenciales de apps/proveedores persistidas via
# /v1/admin/apps/* (ver core/security/crypto.py) - Fernet, generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vacia = ese endpoint falla con RuntimeError en el primer intento de leer
# o escribir una credencial (nunca un fallback a texto plano). Nota: hoy
# NEXOLU_APPS_JSON (arriba) sigue siendo la fuente de verdad hasta que se
# corra `python scripts/migrate_apps_json_to_db.py` en un ambiente - ver
# core/auth/apps.py para el fallback de transicion.
COMMS_MASTER_KEY=

# Formularios de WhatsApp (WhatsApp Flows) generados con IA: Connect llama a
# nexolu-ia-core (POST /v1/completions) como una app mas. En ia-core, darla
# de alta como app "connect" con proveedor anthropic y modelo claude-opus-5.
# Vacios = "Generar con IA" responde 503; el resto de Formularios funciona.
IA_CORE_BASE_URL=
IA_CORE_API_KEY=
IA_CORE_TIMEOUT_SECONDS=180

# Formularios que se crean y publican solos al conectar el numero propio de
# un negocio (Embedded Signup), por app: {"spa": ["confirm_booking"]}. La app
# recibe el flow_id en el evento firmado `whatsapp_flow_provisioned`.
WHATSAPP_FLOW_AUTOPROVISION={}

LOG_LEVEL=INFO
